# Copy to .env and fill in. The app refuses to start if a required value is missing.

# ---------------------------------------------------------------- required ---

DATABASE_URL=postgresql://nestedflow:nestedflow@localhost:5432/nestedflow

# Generate a real one: openssl rand -base64 48
AUTH_SECRET=replace-me-with-at-least-32-characters-of-entropy

# ---------------------------------------------------------------- optional ---

APP_URL=http://localhost:3000

# Postgres connections held by ONE instance of this process. On a serverless
# host many instances run at once and each opens its own pool, so the real
# total is this times the number of warm instances. Behind a transaction-mode
# pooler, set this to 1.
DATABASE_MAX_CONNECTIONS=10

SESSION_ABSOLUTE_DAYS=30
SESSION_IDLE_HOURS=72

# Set to true ONLY when a trusted proxy rewrites X-Forwarded-For.
# With it off, per-IP rate limiting cannot attribute requests and falls back to
# a higher global ceiling — see src/lib/security/rate-limit.ts.
TRUST_PROXY_HEADERS=false

# Google sign-in. Both are needed, or the feature stays off and the button is
# not rendered. Create an OAuth 2.0 Web application client in a Google Cloud
# project you control, and register this exact redirect URI:
#   ${APP_URL}/api/auth/google/callback
# There is no default that could be correct, and none is supplied.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email transport. "console" writes the message to the server log and sends
# nothing — the honest default when no provider is configured. "resend" delivers
# through Resend (https://resend.com) and needs RESEND_API_KEY. "none" disables
# sending entirely.
#
# Password reset is only offered to users when a real transport is configured:
# a reset link printed to a server log reaches nobody.
#
# With Resend, EMAIL_FROM must be on a domain you have verified in Resend.
# "onboarding@resend.dev" works without one, but delivers ONLY to the address
# that owns the Resend account — fine for testing, useless for real users.
EMAIL_TRANSPORT=console
EMAIL_FROM=Nested Flow <no-reply@localhost>
RESEND_API_KEY=

# Bill photos kept from the scanner. "auto" uses a private Vercel Blob store
# when BLOB_READ_WRITE_TOKEN is set (Vercel adds it when a Blob store is
# connected to the project) and otherwise keeps no photos — the scanner still
# reads bills, it just offers no "keep the photo" option. "local" writes them
# under BILL_STORAGE_DIR, for development and tests only. "none" turns it off.
BILL_STORAGE=auto
BILL_STORAGE_DIR=.data/bills
BLOB_READ_WRITE_TOKEN=

# The daily reminders job (bill reminder emails), run by Vercel Cron from
# vercel.json. Vercel sends this value as "Authorization: Bearer <CRON_SECRET>";
# set it to a long random string (openssl rand -hex 32) in the project's
# environment variables. Unset, the job refuses every call.
CRON_SECRET=

# Live markets. Crypto prices stream from Binance's public market data and need
# nothing here. Spot gold and silver, forex, and US and Indian shares need a
# market-data key. Alpha Vantage (https://www.alphavantage.co/support/#api-key)
# is used when ALPHA_VANTAGE_API_KEY is set, otherwise Twelve Data
# (https://twelvedata.com). Without a key those tiles say so instead of showing
# a price. Which symbols a key can read depends on its plan.
#
# Alpha Vantage's free key allows 25 requests a day and 5 a minute; the app never
# spends past ALPHA_VANTAGE_DAILY_LIMIT / ALPHA_VANTAGE_PER_MINUTE. On a paid plan
# set the daily limit to 0 (no cap) and the per-minute limit to your plan's.
# MARKET_POLL_SECONDS, if set, is how often each keyed price is refreshed; unset,
# the refresh follows the allowance.
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_DAILY_LIMIT=25
ALPHA_VANTAGE_PER_MINUTE=5
TWELVE_DATA_API_KEY=
MARKET_POLL_SECONDS=
