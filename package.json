{
  "name": "kylix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run && pnpm -r --filter @kylix/domain --filter @kylix/tokens test",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate:e2e": "DATABASE_URL=postgresql://kylix:kylix@localhost:5432/kylix_e2e tsx src/lib/db/migrate.ts",
    "audit": "pnpm audit --audit-level=high",
    "tokens:build": "pnpm --filter @kylix/tokens build:css"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "uuidv7": "1.2.1",
    "zod": "4.6.5",
    "@fontsource-variable/inter": "5.3.0",
    "arctic": "3.7.0",
    "jose": "6.2.12",
    "rrule": "2.8.1",
    "@kylix/domain": "workspace:*",
    "@kylix/tokens": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0"
    }
  }
}
